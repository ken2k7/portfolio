---
import { site, hero, folders } from '../data/content';
const tones = ['var(--paper-2)', 'var(--paper)', 'var(--paper-2)', 'var(--paper)'];
---

<section class="hero" aria-labelledby="name">
  <div class="row">
    <button type="button" class="toggle" data-theme-toggle hidden>Dark mode</button>
  </div>

  <div class="head">
    <h1 id="name" class="display enter">Kenil Gandhi</h1>
    <p class="sentence enter" style="--delay: 120ms">{hero.sentence}</p>
  </div>

  <nav class="stack" aria-label="Sections of this page">
    <ul>
      {
        folders.map((f, i) => (
          <li class:list={["folder", "enter", { first: i === 0 }]} style={`--fbg: ${tones[i]}; --tab-x: ${(4 - i) * 20}%; --delay: ${220 + i * 70}ms`}>
            <a class="tab" href={`#${f.id}`}>
              {f.name}
            </a>
            <a class="strip" href={`#${f.id}`} tabindex="-1" aria-hidden="true">
              <span class="hint">{f.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .hero {
    padding: 0 var(--margin);
    background: var(--ground);
    color: var(--on-ground);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    min-height: 56px;
    padding-top: 8px;
    font-size: 1rem;
  }
  .toggle {
    grid-column: 2;
    justify-self: end;
    appearance: none;
    background: none;
    border: 0;
    padding: 8px 0;
    min-height: 44px;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .head {
    min-height: calc(50svh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px 0 32px;
  }
  .display {
    font-size: var(--step-display);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .sentence {
    margin-top: clamp(20px, 3vw, 36px);
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 46ch;
  }

  /* The folder stack */
  .stack {
    width: 86%;
    margin: 0 auto;
  }
  .stack ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .folder {
    position: relative;
    padding-top: 44px;
  }
  .folder + .folder {
    margin-top: -44px;
  }
  .folder .tab {
    position: absolute;
    top: 0;
    left: min(var(--tab-x), calc(100% - 180px));
  }
  .strip {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 64px;
    padding: 0 28px;
    background: var(--fbg);
    color: var(--ink);
    text-decoration: none;
  }
  .hint {
    font-size: 1rem;
    color: var(--muted);
  }
  .first .strip {
    justify-content: flex-start;
  }
  .strip:hover .hint {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: 1fr auto;
    }
    .head {
      min-height: calc(48svh - 56px);
      padding: 16px 0 24px;
    }
    .stack {
      width: 100%;
    }
    .folder {
      padding-top: 36px;
    }
    .folder + .folder {
      margin-top: -36px;
    }
    .folder .tab {
      height: 36px;
      line-height: 36px;
      min-width: 120px;
      padding: 0 16px;
      font-size: 1.25rem;
      left: min(var(--tab-x), calc(100% - 130px));
    }
    .strip {
      height: 52px;
      padding: 0 14px;
    }
    .hint {
      display: none;
    }
  }
</style>

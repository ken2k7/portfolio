---
import { Picture, getImage } from 'astro:assets';
import { hero, folders } from '../data/content';
import doha from '../assets/photos/doha.jpg';
const tones = ['var(--paper-2)', 'var(--paper)', 'var(--paper-2)', 'var(--paper)'];
const texture = await getImage({ src: doha, width: 1600, format: 'webp', quality: 78 });
---

<section class="hero" aria-labelledby="name">
  <div class="photo">
    <Picture
      src={doha}
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      alt="The West Bay skyline of Doha at night, lit towers reflected in the water of the Corniche."
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-img"
    />
    <canvas class="hero-canvas" data-src={texture.src} data-w={texture.attributes.width} data-h={texture.attributes.height} aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>
  </div>

  <div class="row">
    <button type="button" class="toggle" data-theme-toggle hidden>Dark mode</button>
  </div>

  <div class="head">
    <h1 id="name" class="display enter">Kenil Gandhi</h1>
    <p class="sentence enter" style="--delay: 120ms">{hero.sentence}</p>
  </div>

  <nav class="stack" aria-label="Sections of this page">
    <ul>
      {
        folders.map((f, i) => (
          <li class:list={['folder', 'enter', { first: i === 0 }]} style={`--fbg: ${tones[i]}; --tab-x: ${(4 - i) * 20}%; --delay: ${220 + i * 70}ms`}>
            <a class="tab" href={`#${f.id}`}>
              {f.name}
            </a>
            <a class="strip" href={`#${f.id}`} tabindex="-1" aria-hidden="true">
              <span class="hint">{f.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<script>
  // Water ripple on the hero photograph. A small WebGL program, no library.
  // The photograph underneath is an ordinary <img>, so nothing depends on this running.
  const heroEl = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const finePointer = window.matchMedia('(pointer: fine)').matches;
  if (heroEl && canvas && !reduce && finePointer) {
    let started = false;
    const boot = () => {
      if (started) return;
      started = true;
      const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: false, powerPreference: 'low-power' });
      if (gl) start(gl, canvas, heroEl);
    };
    // Start on the first pointer movement, or once the page has loaded and the browser is idle.
    heroEl.addEventListener('pointermove', boot, { once: true, passive: true });
    window.addEventListener('load', () => {
      const idle = (window as any).requestIdleCallback as undefined | ((cb: () => void, o?: { timeout: number }) => void);
      if (idle) idle(boot, { timeout: 4000 });
      else setTimeout(boot, 2500);
    });
  }

  function start(gl: WebGLRenderingContext, canvas: HTMLCanvasElement, hero: HTMLElement) {
    const vs = `attribute vec2 p; varying vec2 v; void main(){ v = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }`;
    const fs = `
      precision mediump float;
      varying vec2 v;
      uniform sampler2D t;
      uniform vec2 res;
      uniform vec2 img;
      uniform float time;
      uniform vec3 rip[8];
      void main() {
        float ra = res.x / res.y;
        float ia = img.x / img.y;
        vec2 uv = v;
        if (ra > ia) { uv.y = (uv.y - 0.5) * (ia / ra) + 0.5; } else { uv.x = (uv.x - 0.5) * (ra / ia) + 0.5; }
        uv.y = 1.0 - uv.y;
        vec2 d = vec2(0.0);
        for (int i = 0; i < 8; i++) {
          vec3 r = rip[i];
          float age = time - r.z;
          if (age > 0.0 && age < 3.2) {
            vec2 dir = v - r.xy;
            dir.x *= ra;
            float dist = length(dir) + 1e-4;
            float wave = sin(dist * 42.0 - age * 7.0) * exp(-age * 1.1) * exp(-dist * 3.2) * smoothstep(0.0, 0.1, age);
            d += (dir / dist) * wave * 0.014;
          }
        }
        float water = smoothstep(0.58, 0.72, uv.y);
        d.y += sin(uv.x * 7.0 + time * 0.7) * 0.0022 * water;
        d.x += sin(uv.y * 9.0 - time * 0.5) * 0.0012 * water;
        gl_FragColor = texture2D(t, clamp(uv + d, 0.001, 0.999));
      }`;
    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'res');
    const uImg = gl.getUniformLocation(prog, 'img');
    const uTime = gl.getUniformLocation(prog, 'time');
    const uRip = gl.getUniformLocation(prog, 'rip');

    const ripples = new Float32Array(24).fill(-99);
    let next = 0;
    let visible = true;
    let ready = false;
    const t0 = performance.now();

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = Math.round(hero.clientWidth * dpr);
      const h = Math.round(hero.clientHeight * dpr);
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
      gl.uniform2f(uRes, w, h);
    };

    const addRipple = (clientX: number, clientY: number) => {
      const r = hero.getBoundingClientRect();
      const x = (clientX - r.left) / r.width;
      const y = 1 - (clientY - r.top) / r.height;
      ripples[next * 3] = x;
      ripples[next * 3 + 1] = y;
      ripples[next * 3 + 2] = (performance.now() - t0) / 1000;
      next = (next + 1) % 8;
    };
    let last = 0;
    hero.addEventListener(
      'pointermove',
      (e) => {
        const now = performance.now();
        if (now - last > 90) {
          last = now;
          addRipple(e.clientX, e.clientY);
        }
      },
      { passive: true },
    );
    hero.addEventListener('pointerdown', (e) => addRipple(e.clientX, e.clientY), { passive: true });

    const frame = () => {
      if (!visible || !ready) return;
      resize();
      gl.uniform1f(uTime, (performance.now() - t0) / 1000);
      gl.uniform3fv(uRip, ripples);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(frame);
    };

    new IntersectionObserver(
      (entries) => {
        const was = visible;
        visible = entries[0].isIntersecting;
        if (visible && !was) requestAnimationFrame(frame);
      },
      { threshold: 0 },
    ).observe(hero);

    const image = new Image();
    image.decoding = 'async';
    image.onload = () => {
      const tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, image);
      gl.uniform2f(uImg, image.naturalWidth, image.naturalHeight);
      ready = true;
      canvas.classList.add('is-ready');
      requestAnimationFrame(frame);
    };
    image.src = canvas.dataset.src!;
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding: 0 var(--margin);
    background: var(--ground);
    color: var(--on-ground);
    display: flex;
    flex-direction: column;
  }
  .photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    filter: brightness(0.66) saturate(1.05);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    filter: brightness(0.66) saturate(1.05);
    transition: opacity 1.2s ease;
    pointer-events: none;
  }
  .hero-canvas.is-ready {
    opacity: 1;
  }
  /* The one permitted gradient: a scrim so the type and folders read on the photograph. */
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(6, 43, 138, 0.45) 0%, rgba(6, 43, 138, 0.3) 35%, rgba(6, 43, 138, 0.6) 70%, var(--ground) 100%);
  }
  :root[data-theme='dark'] .scrim {
    background: linear-gradient(to bottom, rgba(4, 22, 63, 0.5) 0%, rgba(4, 22, 63, 0.3) 35%, rgba(4, 22, 63, 0.65) 70%, var(--ground) 100%);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .scrim {
      background: linear-gradient(to bottom, rgba(4, 22, 63, 0.5) 0%, rgba(4, 22, 63, 0.3) 35%, rgba(4, 22, 63, 0.65) 70%, var(--ground) 100%);
    }
  }

  .row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 56px;
    padding-top: 8px;
  }
  .toggle {
    appearance: none;
    background: none;
    border: 0;
    padding: 8px 0;
    min-height: 44px;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .head {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px 0 40px;
  }
  .display {
    font-size: var(--step-display);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .sentence {
    margin-top: clamp(20px, 3vw, 36px);
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 46ch;
  }

  .stack {
    width: 86%;
    margin: 0 auto;
  }
  .stack ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .folder {
    position: relative;
    padding-top: 44px;
  }
  .folder + .folder {
    margin-top: -44px;
  }
  .folder .tab {
    position: absolute;
    top: 0;
    left: min(var(--tab-x), calc(100% - 180px));
  }
  .strip {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 64px;
    padding: 0 28px;
    background: var(--fbg);
    color: var(--ink);
    text-decoration: none;
  }
  .hint {
    font-size: 1rem;
    color: var(--muted);
  }
  .first .strip {
    justify-content: flex-start;
  }
  .strip:hover .hint {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .head {
      padding: 16px 0 28px;
    }
    .stack {
      width: 100%;
    }
    .folder {
      padding-top: 36px;
    }
    .folder + .folder {
      margin-top: -36px;
    }
    .folder .tab {
      height: 36px;
      line-height: 36px;
      min-width: 120px;
      padding: 0 16px;
      font-size: 1.25rem;
      left: min(var(--tab-x), calc(100% - 130px));
    }
    .strip {
      height: 52px;
      padding: 0 14px;
    }
    .hint {
      display: none;
    }
  }
</style>

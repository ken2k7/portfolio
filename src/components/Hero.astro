---
import { Picture } from 'astro:assets';
import { site, stage } from '../data/content';
import doha from '../assets/photos/doha.jpg';
---

<section class="hero" aria-labelledby="name">
  <div class="film-wrap">
    <Picture
      src={doha}
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      alt="The West Bay skyline of Doha at night, lit towers reflected in the water of the Corniche."
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="film"
    />
  </div>
  <div class="scrim bottom"></div>
  <div class="hero-text">
    <h1 id="name" class="display">Kenil Gandhi</h1>
    <p class="lead">{stage.tagline}</p>
    <div class="actions">
      <a class="button" href={site.resume} download>Download resume<span class="sr-only"> (PDF)</span></a>
      <a class="button ghost" href="#contents">What's here</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    align-content: end;
    padding: 120px var(--margin) clamp(48px, 8vh, 96px);
  }
  .film-wrap {
    position: absolute;
    inset: 0;
  }
  .film-wrap :global(picture),
  .film-wrap :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: brightness(0.62) saturate(0.85) contrast(1.05);
  }
  .hero-text {
    position: relative;
    z-index: 1;
    max-width: 1400px;
  }
  .display {
    margin-left: -0.04em;
  }
  .hero-text .lead {
    margin-top: 24px;
    max-width: 34ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>

---
// A row of semicircular scallops in the paper colour, used to shape a sheet's edge.
// `flip` points the scallops downward (for a bottom edge).
interface Props {
  flip?: boolean;
  class?: string;
}
const { flip = false, class: extra = '' } = Astro.props;
---

<svg class:list={['scallop', extra, { flip }]} viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={flip ? 'sc-down' : 'sc-up'} width="24" height="12" patternUnits="userSpaceOnUse">
      {flip ? <path d="M0 0h24v0a12 12 0 0 1-24 0z" /> : <path d="M0 12a12 12 0 0 1 24 0z" />}
    </pattern>
  </defs>
  <rect width="120" height="12" fill={`url(#${flip ? 'sc-down' : 'sc-up'})`} />
</svg>

<style>
  .scallop {
    display: block;
    width: 100%;
    height: 16px;
    fill: var(--sheet, var(--paper));
  }
</style>

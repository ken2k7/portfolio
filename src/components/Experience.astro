---
import Section from './Section.astro';
import { experience } from '../data/content';
---

<Section id="experience" number="02 — Experience" title="Where I have worked.">
  <ol class="divide-y rule border-y rule">
    {
      experience.map((job) => (
        <li class="reveal grid gap-4 py-8 sm:grid-cols-12 sm:gap-8">
          <div class="sm:col-span-4">
            <p class="label">{job.when}</p>
            <h3 class="mt-3 text-2xl font-display leading-tight">{job.company}</h3>
            <p class="mt-1 text-ink-soft">{job.role}</p>
            <p class="mt-1 text-sm text-ink-soft">{job.where}</p>
          </div>
          <ul class="space-y-4 text-base leading-relaxed sm:col-span-8">
            {job.bullets.map((b) => (
              <li class="relative pl-5 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-2.5 before:bg-rule-strong">
                {b}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>

---
import Section from './Section.astro';
import { leadership, awards } from '../data/content';
---

<Section id="leadership" number="06 — Leadership and awards" title="Beyond the keyboard.">
  <h3 class="label">Leadership and activities</h3>
  <ul class="mt-4 divide-y rule border-y rule">
    {
      leadership.map((item) => (
        <li class="reveal grid gap-2 py-5 sm:grid-cols-12 sm:gap-8">
          <p class="label sm:col-span-3 sm:pt-1">{item.when}</p>
          <div class="sm:col-span-9">
            <p class="text-lg leading-snug">
              <span class="font-medium">{item.org}</span>
              <span class="text-ink-soft"> &middot; {item.role}</span>
            </p>
            <p class="mt-1 leading-relaxed text-ink-soft">{item.detail}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="label mt-14">Awards</h3>
  <ol class="mt-4 divide-y rule border-y rule">
    {
      awards.map((a) => (
        <li class="reveal grid gap-2 py-5 sm:grid-cols-12 sm:gap-8">
          <p class="label ledger sm:col-span-3 sm:pt-1">{a.year}</p>
          <div class="sm:col-span-9">
            <p class="text-lg leading-snug">{a.title}</p>
            <p class="mt-1 leading-relaxed text-ink-soft">{a.where}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

---
import { letter } from '../data/content';
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="grid12">
    <div class="left">
      <h2 id="about-title" class="head">About</h2>
      <svg class="route" viewBox="0 0 600 260" role="img" aria-labelledby="route-title">
        <title id="route-title">A line from Doha to Singapore.</title>
        <path d="M60 200 C 180 20, 420 20, 540 200" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 8" />
        <circle cx="60" cy="200" r="6" fill="var(--accent)" />
        <circle cx="540" cy="200" r="6" fill="var(--accent)" />
        <text x="60" y="238" font-size="18" fill="currentColor" font-family="var(--font)" font-weight="500">Doha</text>
        <text x="540" y="238" font-size="18" fill="currentColor" font-family="var(--font)" font-weight="500" text-anchor="end">Singapore</text>
      </svg>
    </div>
    <div class="right">
      {letter.paragraphs.map((p) => <p>{p}</p>)}
      <p class="sign">{letter.signature}<span class="muted"> {letter.role}</span></p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-2);
  }
  .left {
    grid-column: 1 / span 5;
  }
  .route {
    margin-top: 48px;
    width: 100%;
    max-width: 520px;
    color: var(--muted);
  }
  .right {
    grid-column: 7 / span 6;
    font-size: var(--step-lead);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .right p {
    max-width: 36ch;
  }
  .right p + p {
    margin-top: 1em;
  }
  .sign {
    margin-top: 1.6em;
    font-weight: 800;
    font-size: var(--step-body);
  }
  .sign .muted {
    font-weight: 400;
  }
  @media (max-width: 1023px) {
    .left,
    .right {
      grid-column: 1 / -1;
    }
    .right {
      margin-top: 40px;
    }
  }
</style>

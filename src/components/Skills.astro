---
import { skills } from '../data/content';
---

<section id="skills" class="section skills" aria-labelledby="skills-title">
  <h2 id="skills-title" class="head">Skills</h2>
  <dl>
    {
      skills.map((g) => (
        <div class="row">
          <dt class="muted">{g.group}</dt>
          <dd>
            {g.items.map((item, i) => (
              <>
                <span class="item">{item}</span>
                {i < g.items.length - 1 && <span class="sep" aria-hidden="true"> </span>}
              </>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .skills {
    background: var(--bg);
  }
  dl {
    margin: 48px 0 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    column-gap: var(--gutter);
    padding: 22px 0;
    background:
      linear-gradient(var(--surface), var(--surface)) bottom / 100% 2px no-repeat;
  }
  dt {
    padding-top: 0.35em;
  }
  dd {
    margin: 0;
    font-size: clamp(1.375rem, 1rem + 1.8vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .item {
    display: inline;
  }
  .sep::before {
    content: "/";
    margin: 0 0.35em;
    color: var(--muted);
    font-weight: 400;
  }
  @media (max-width: 767px) {
    .row {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }
  }
</style>

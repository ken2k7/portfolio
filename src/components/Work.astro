---
import { Picture } from 'astro:assets';
import { site, workIntro, workFiles } from '../data/content';
import casebook from '../assets/photos/casebook.jpg';
import plan from '../assets/photos/plan.jpg';
import excavation from '../assets/photos/excavation.jpg';
const photos: Record<string, { src: ImageMetadata; alt: string; caption: string }[]> = {
  medigraph: [
    {
      src: casebook,
      alt: 'A page of a handwritten physician\u2019s casebook listing patients, remedies such as eye water and tincture, and charges.',
      caption: 'Francis Paddock\u2019s casebook: remedies and charges, by hand.',
    },
  ],
  infrasync: [
    {
      src: plan,
      alt: 'A coloured 1893 plan of the city of Singapore showing its street grid, river and harbour.',
      caption: 'Plan of the City of Singapore, Constable\u2019s Hand Atlas of India, 1893.',
    },
    {
      src: excavation,
      alt: 'A black and white archival photograph of Sunset Boulevard in Los Angeles cut open for excavation, palm trees along the kerb.',
      caption: 'Sunset Boulevard, cut open.',
    },
  ],
};
import FigMediGraph from './figures/FigMediGraph.astro';
import FigInfraSync from './figures/FigInfraSync.astro';
import FigKgisl from './figures/FigKgisl.astro';
import FigKenbot from './figures/FigKenbot.astro';
const figures = { medigraph: FigMediGraph, infrasync: FigInfraSync, kgisl: FigKgisl, kenbot: FigKenbot };
---

<section id="work" class="front" aria-labelledby="work-title">
  <h2 id="work-title" class="tab">Work</h2>
  <div class="folder-body">
    <div class="opening">
      <a href={site.resume} download class="button">Download resume<span class="sr-only"> (PDF)</span></a>
      <p class="lead intro">{workIntro}</p>
    </div>

    <div class="bands">
      {
        workFiles.map((w, i) => {
          const Fig = figures[w.figure];
          return (
            <article id={w.id} class:list={['band', i % 2 === 0 ? 'band-a' : 'band-b']} style={`--i: ${i}`} aria-labelledby={`${w.id}-title`}>
              <h3 id={`${w.id}-title`} class="tab band-tab">
                {w.name}
              </h3>
              <p class="kind">{w.kind}</p>
              <div class="band-grid">
                <div class="figure">
                  {photos[w.id] && (
                    <div class:list={['plates', { two: photos[w.id].length === 2 }]}>
                      {photos[w.id].map((ph) => (
                        <figure class="plate opens">
                          <Picture src={ph.src} widths={[400, 700, 1000, 1400, 1800]} sizes="(min-width: 1024px) 48vw, calc(100vw - 32px)" formats={['avif', 'webp']} alt={ph.alt} loading="lazy" decoding="async" />
                          <figcaption class="caption">{ph.caption}</figcaption>
                        </figure>
                      ))}
                    </div>
                  )}
                  <Fig />
                </div>
                <div class="text">
                  <p class="summary">{w.summary}</p>
                  <ul class="points">
                    {w.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                  <p class="stack-line small">{w.stack}</p>
                  {w.links && (
                    <ul class="links">
                      {w.links.map((l) => (
                        <li>
                          <a href={l.href} target="_blank" rel="noopener noreferrer">
                            {l.label}
                            <span class="sr-only"> (opens in a new tab)</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .front {
    position: relative;
    width: 86%;
    margin: -44px auto 0;
    padding-top: 44px;
    --fbg: var(--paper-2);
    --tab-x: 0%;
  }
  .front > .tab {
    position: absolute;
    top: 0;
    left: min(var(--tab-x), calc(100% - 180px));
  }
  .folder-body {
    background: var(--fbg);
    color: var(--ink);
    padding: 32px 32px 48px;
  }
  .opening {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
  }
  .intro {
    color: var(--ink);
  }

  /* Project bands pile up as the page scrolls. */
  .bands {
    margin-top: 48px;
  }
  .band {
    position: sticky;
    top: calc(var(--i) * 72px + 44px);
    min-height: 80svh;
    margin-top: 44px;
    padding: 0 32px 56px;
  }
  .band + .band {
    margin-top: 44px;
  }
  .band:last-child {
    min-height: 0;
  }
  .band-a {
    background: var(--paper);
    color: var(--ink);
    --fig-bg: var(--paper);
    --fig-ink: var(--ink);
    --quiet: var(--muted);
  }
  .band-b {
    background: var(--band-b);
    color: var(--on-band-b);
    --tab: var(--paper);
    --on-tab: var(--ink);
    --fig-bg: var(--band-b);
    --fig-ink: var(--on-band-b);
    --quiet: var(--on-band-b-muted);
  }
  .band-tab {
    position: absolute;
    top: -44px;
    left: 0;
    font-size: 1.75rem;
  }
  .kind {
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 28px;
    text-align: right;
    color: var(--quiet);
    max-width: none;
  }
  .band-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 32px;
    margin-top: 52px;
  }
  .figure {
    grid-column: 1 / span 7;
    align-self: start;
  }
  .plates {
    display: grid;
    gap: var(--gutter);
    margin-bottom: 32px;
  }
  .plates.two {
    grid-template-columns: 2fr 1fr;
  }
  .plate {
    margin: 0;
    aspect-ratio: 16 / 10;
  }
  .plates.two .plate {
    aspect-ratio: 4 / 3;
  }
  .plate :global(picture),
  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plate .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 6px 10px;
    color: #f2ebdc;
    background: rgba(20, 24, 40, 0.55);
  }
  .text {
    grid-column: 8 / span 5;
  }
  .summary {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 36ch;
  }
  .points {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    max-width: 60ch;
  }
  .points li + li {
    margin-top: 0.8em;
  }
  .stack-line {
    margin-top: 24px;
    color: var(--quiet);
  }
  .links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  @media (max-width: 1023px) {
    .figure {
      grid-column: 1 / -1;
    }
    .text {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .plates.two {
      grid-template-columns: 1fr;
    }
    .plates.two .plate {
      aspect-ratio: 16 / 10;
    }
    .front {
      width: 100%;
      margin-top: -36px;
      padding-top: 36px;
    }
    .front > .tab {
      height: 36px;
      line-height: 36px;
      min-width: 120px;
      padding: 0 16px;
      font-size: 1.25rem;
      left: min(var(--tab-x), calc(100% - 130px));
    }
    .folder-body {
      padding: 20px 16px 40px;
    }
    .bands {
      margin-top: 40px;
    }
    .band {
      position: relative;
      top: auto;
      min-height: 0;
      margin-top: 40px;
      padding: 0 16px 40px;
    }
    .band + .band {
      margin-top: 40px;
    }
    .band-tab {
      top: -40px;
      height: 40px;
      line-height: 40px;
      font-size: 1.375rem;
      min-width: 0;
    }
    .kind {
      justify-content: flex-start;
      text-align: left;
      padding-top: 10px;
    }
  }
</style>

---
import { site, contact } from '../data/content';
const year = new Date().getFullYear();
---

<footer id="contact" class="section contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="display">Write to me.</h2>
  <p class="lead muted">{contact.message}</p>
  <div class="actions">
    <a class="button" href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
    <a href={site.resume} download>Resume, PDF</a>
  </div>
  <p class="imprint small muted">
    &copy; {year} Kenil Gandhi. Interface pieces are from MediGraph and InfraSync. The trench clip was generated for the InfraSync demo.
    Doha photograph: <a href="https://commons.wikimedia.org/wiki/File:Doha_West_Bay_Skyline_Qatar_Jan_2020.jpg" target="_blank" rel="noopener noreferrer">Doha West Bay Skyline<span class="sr-only"> (opens in a new tab)</span></a> by Thameur Belghith, CC BY-SA 4.0.
  </p>
</footer>

<style>
  .contact {
    background: var(--bg);
    padding-bottom: 48px;
  }
  .display {
    font-size: clamp(3rem, 12vw, 11rem);
    margin-left: -0.04em;
  }
  .lead {
    margin-top: 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 36px;
    font-size: var(--step-lead);
  }
  .actions .button {
    font-size: 1.125rem;
    overflow-wrap: anywhere;
  }
  .imprint {
    margin-top: 96px;
    max-width: none;
  }
</style>

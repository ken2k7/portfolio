---
import { Picture } from 'astro:assets';
import { site, contact } from '../data/content';
import { credits } from '../data/credits';
import Scallop from './Scallop.astro';
import souq from '../assets/photos/souq.jpg';
const year = new Date().getFullYear();
const used = ['doha', 'dunes', 'hdb', 'casebook', 'plan', 'excavation', 'nus', 'souq'];
const shown = used.map((n) => credits.find((c) => c.name === n)!).filter(Boolean);
const shortTitle: Record<string, string> = {
  doha: 'Doha West Bay skyline',
  dunes: 'Khor Al Udayd',
  hdb: 'Tampines Street 45',
  casebook: 'Paddock casebook',
  plan: 'Plan of the City of Singapore, 1893',
  excavation: 'Sunset Boulevard excavation',
  nus: 'CREATE Tower, NUS',
  souq: 'Souq Waqif by night',
};
---

<footer id="contact" class="curtain back" aria-labelledby="contact-title">
  <div class="panel-wrap">
    <Scallop flip class="cut" />
    <div class="panel">
      <div class="left">
        <h2 id="contact-title">Contact</h2>
        <p class="message">{contact.message}</p>
        <a class="top" href="#top">Back to the top</a>
      </div>
      <div class="right">
        <figure class="stamp">
          <Picture
            src={souq}
            widths={[320, 480]}
            sizes="160px"
            formats={['avif', 'webp']}
            alt="The lit lanes of Souq Waqif in Doha at night, with the spiral minaret of the Islamic Cultural Centre behind."
            loading="lazy"
            decoding="async"
          />
          <figcaption class="sr-only">Souq Waqif, Doha, at night.</figcaption>
        </figure>
      <ul class="address">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        </li>
        <li>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        </li>
        <li><a href={site.resume} download>Resume, PDF</a></li>
      </ul>
      </div>
      <p class="imprint small">&copy; {year} Kenil Gandhi</p>
      <p class="credits small">
        Photographs from Wikimedia Commons:
        {
          shown.map((c, i) => (
            <>
              <a href={c.page} target="_blank" rel="noopener noreferrer">{shortTitle[c.name]}</a>
              {' '}by {c.artist || 'unknown'}, {c.license}{i < shown.length - 1 ? '; ' : '.'}
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .back {
    background: var(--paper);
    color: var(--ink);
    padding: 120px var(--margin) 0;
  }
  .panel-wrap {
    width: min(1100px, 100%);
    margin: 0 auto;
    --sheet: var(--paper);
  }
  .cut {
    position: relative;
    z-index: 1;
    margin-bottom: -16px;
  }
  .panel {
    position: relative;
    background: var(--ground);
    color: var(--on-ground);
    min-height: 420px;
    padding: 48px 56px 56px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
    row-gap: 48px;
  }
  h2 {
    font-size: 2rem;
    line-height: 1;
  }
  .message {
    margin-top: 20px;
    max-width: 34ch;
  }
  .top {
    display: inline-block;
    margin-top: 32px;
  }
  .right {
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 28px;
  }
  .stamp {
    margin: 0;
    width: 160px;
    aspect-ratio: 3 / 4;
    padding: 6px;
    background: var(--paper);
    transform: rotate(2deg);
  }
  .stamp :global(picture),
  .stamp :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .address {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font-size: var(--step-lead);
    line-height: 1.3;
  }
  .address li + li {
    margin-top: 12px;
  }
  .address a {
    overflow-wrap: anywhere;
  }
  .imprint {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--on-ground-muted);
    max-width: none;
    align-self: end;
  }
  .credits {
    grid-column: 1 / -1;
    color: var(--on-ground-muted);
    max-width: none;
    line-height: 1.5;
  }
  @media (max-width: 767px) {
    .back {
      padding-top: 72px;
    }
    .panel {
      grid-template-columns: 1fr;
      padding: 32px 20px 40px;
      row-gap: 32px;
      min-height: 0;
    }
    .right {
      justify-self: start;
      align-items: flex-start;
    }
    .address {
      text-align: left;
    }
  }
</style>

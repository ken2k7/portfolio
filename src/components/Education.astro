---
import { site, record } from '../data/content';
---

<section id="education" class="section education" aria-labelledby="education-title">
  <div class="grid12">
    <div class="side">
      <h2 id="education-title" class="head">Education and activities</h2>
      <p class="lead muted">{record.school}. {record.degree}</p>
      <a href={site.resume} download class="button">Download resume<span class="sr-only"> (PDF)</span></a>
    </div>
    <div class="ledger">
      {
        record.groups.map((g) => (
          <div class="group">
            <h3>{g.name}</h3>
            <ul>
              {g.items.map((it) => (
                <li>
                  <div class="line">
                    <span class="left">{it.left}</span>
                    <span class="right num muted">{it.right}</span>
                  </div>
                  {it.note && <p class="note small muted">{it.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .education {
    background: var(--bg-2);
  }
  .side {
    grid-column: 1 / span 5;
    position: sticky;
    top: 96px;
    align-self: start;
  }
  .side .lead {
    margin-top: 24px;
    max-width: 30ch;
  }
  .side .button {
    margin-top: 32px;
  }
  .ledger {
    grid-column: 7 / span 6;
  }
  .group + .group {
    margin-top: 56px;
  }
  h3 {
    font-size: var(--step-lead);
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 14px;
  }
  .line {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    font-weight: 500;
  }
  .left {
    max-width: 34ch;
  }
  .right {
    flex: none;
  }
  .note {
    margin-top: 4px;
    max-width: 48ch;
  }
  @media (max-width: 1023px) {
    .side {
      grid-column: 1 / -1;
      position: static;
    }
    .ledger {
      grid-column: 1 / -1;
      margin-top: 56px;
    }
  }
</style>

---
import Section from './Section.astro';
import { education, learning } from '../data/content';
---

<Section id="education" number="05 — Education" title="Study and learning.">
  <div class="reveal">
    <p class="label">{education.when}</p>
    <h3 class="font-display mt-3 text-3xl leading-tight">{education.school}</h3>
    <p class="mt-1 text-ink-soft">{education.degree}</p>

    <h4 class="label mt-8">Coursework</h4>
    <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
      {
        education.coursework.map((c) => (
          <li class="flex items-baseline gap-3 border-b rule py-2 text-[0.9375rem]">
            <span class="ledger w-[4.75rem] shrink-0 text-sm text-ink-soft">{c.code}</span>
            <span>{c.name}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="mt-12 space-y-8">
    {
      learning.map((l) => (
        <li class="reveal grid gap-2 border-t rule pt-6 sm:grid-cols-12 sm:gap-8">
          <h3 class="text-lg font-medium leading-snug sm:col-span-4">{l.title}</h3>
          <p class="leading-relaxed text-ink sm:col-span-8">{l.detail}</p>
        </li>
      ))
    }
  </ul>
</Section>

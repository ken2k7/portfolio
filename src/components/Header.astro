---
import { nav, site } from '../data/content';
---

<header class="sticky top-0 z-40 border-b rule bg-paper/85 backdrop-blur-md supports-[backdrop-filter]:bg-paper/70">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#top" class="font-display text-xl leading-none tracking-tight text-ink hover:text-accent transition-colors" aria-label="KG. Kenil Gandhi, back to top">
      K<span class="italic">G</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-soft transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.resume} download class="hidden xs:inline-flex btn btn-ghost !min-h-9 !px-3.5 !py-2 text-sm">
        Resume
      </a>
      <button
        type="button"
        class="theme-toggle inline-flex h-10 w-10 items-center justify-center rounded-full border border-rule-strong text-ink transition-colors hover:border-accent hover:text-accent"
        aria-label="Switch colour theme"
        title="Switch colour theme"
      >
        <svg class="icon-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" />
        </svg>
        <svg class="icon-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a7 7 0 0 0 10.8 10.8Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

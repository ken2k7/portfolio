---
import '../styles/global.css';
import { site } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og.png', Astro.site ?? site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Computer science student',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'National University of Singapore' },
  address: { '@type': 'PostalAddress', addressCountry: 'SG' },
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#062b8a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#04163f" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A sand-coloured file folder with a tab reading Kenil Gandhi, on cobalt blue." />
    <meta property="og:locale" content="en_SG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#work" class="skip">Skip to the work</a>
    <main id="top">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      // Theme toggle: a text control. Without script the page follows the system setting.
      const root = document.documentElement;
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const effective = () => root.getAttribute('data-theme') ?? (mq.matches ? 'dark' : 'light');
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const sync = () => {
        const next = effective() === 'dark' ? 'light' : 'dark';
        buttons.forEach((b) => {
          b.textContent = next === 'dark' ? 'Dark mode' : 'Light mode';
          b.setAttribute('aria-label', `Switch to ${next} mode`);
        });
      };
      buttons.forEach((b) => {
        b.hidden = false;
        b.addEventListener('click', () => {
          root.setAttribute('data-theme', effective() === 'dark' ? 'light' : 'dark');
          try {
            localStorage.setItem('theme', root.getAttribute('data-theme') ?? '');
          } catch {}
          sync();
        });
      });
      mq.addEventListener('change', sync);
      sync();
    </script>

    <style>
      .skip {
        position: absolute;
        left: var(--margin);
        top: -100px;
        z-index: 50;
        padding: 12px 20px;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.25rem;
        text-decoration: none;
      }
      .skip:focus-visible {
        top: 12px;
      }
    </style>
  </body>
</html>

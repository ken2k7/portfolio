---
import '../styles/global.css';
import { site } from '../data/content';

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og.png', Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: site.url, email: `mailto:${site.email}`,
  jobTitle: 'Computer science student', affiliation: { '@type': 'CollegeOrUniversity', name: 'National University of Singapore' },
  address: { '@type': 'PostalAddress', addressCountry: 'SG' }, sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kenil Gandhi, set in heavy type on near-black, with pieces of the MediGraph and InfraSync interfaces." />
    <meta property="og:locale" content="en_SG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Motion is opt-in by capability: a fine or coarse pointer is fine, reduced motion is not.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contents" class="skip">Skip to content</a>
    <header class="topbar">
      <a href="#top" class="mark" data-mark>Kenil Gandhi</a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
          <li><a href={site.resume} download>Resume</a></li>
        </ul>
      </nav>
    </header>
    <main id="top">
      <slot />
    </main>
    <slot name="footer" />
    <script src="../scripts/motion.ts"></script>
    <style>
      .skip { position: absolute; left: var(--margin); top: -100px; z-index: 50; padding: 12px 20px; background: var(--accent); color: var(--accent-ink); font-weight: 800; text-decoration: none; }
      .skip:focus-visible { top: 12px; }
      nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 22px; }
      nav a { color: var(--ink); opacity: 0.85; }
      nav a:hover { opacity: 1; }
      @media (max-width: 479px) { nav ul { gap: 14px; font-size: 0.9375rem; } }
    </style>
  </body>
</html>
